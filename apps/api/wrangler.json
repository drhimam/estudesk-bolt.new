{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "estudesk-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development"
  },
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "estudesk-sources"
    }
  ]
}
